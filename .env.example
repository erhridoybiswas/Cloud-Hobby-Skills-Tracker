# ---------- Core ----------
SECRET_KEY=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_MINUTES=1440
FLASK_DEBUG=1
PORT=5000

# ---------- Database ----------
# Local: path to SQLite file. Cloud: swap database_service.py to Postgres.
DATABASE_PATH=backend/data/app.db

# ---------- Object Storage ----------
# local | s3 | supabase
STORAGE_BACKEND=local
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH_MB=5

# ---------- Cloud (OPTIONAL — leave blank for local mode) ----------
# Supabase (free tier)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=hobby-tracker

# AWS S3 (free tier)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=